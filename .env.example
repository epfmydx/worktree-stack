# Run make init to generate .env with unique local credentials and this checkout's path.
STACK_NAME=worktree-stack
DEV_DOMAIN=worktree.test
HOST_BIND_IP=127.0.0.1
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443
VITE_PORT=5173
MYSQL_PORT=13306
POSTGRES_PORT=15432
REDIS_PORT=16379

# Change together if this subnet is already used. Networks are scoped by STACK_NAME.
DEV_SUBNET=172.30.240.0/24
DNSMASQ_IP=172.30.240.53
GATEWAY_IP=172.30.240.80
PHP_VERSION=8.4

# Blank values fail closed. make init generates random, local-only credentials.
MYSQL_ROOT_PASSWORD=
POSTGRES_DB=dev
POSTGRES_USER=dev
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DASHBOARD_PASSWORD=
HOST_CONTAINERS_PATH=
