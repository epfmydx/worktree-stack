{
    auto_https off
    admin off
}

:80 {
    handle /api/* {
        reverse_proxy {$BACKEND_HOST:sample-fastapi-api}:8000
    }
    handle {
        reverse_proxy {$FRONTEND_HOST:sample-fastapi-fe}:80 {
            header_up Host {host}
            transport http {
                versions 1.1
            }
        }
    }
}
